cat > .gitignore << 'EOF'
# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
dist/

# production
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# misc
.cache/
coverage/
EOF